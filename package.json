{
  "name": "hanzi-buddy",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/build.mjs && electron .",
    "test": "node scripts/test.mjs",
    "test:lookup": "node scripts/build.mjs && node dist/test-lookup.js",
    "dist": "node scripts/build.mjs && electron-builder --mac",
    "postinstall": "node scripts/fetch-dict.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "pinyin-pro": "^3.29.5"
  },
  "description": "Floating Chinese lookup: pinyin, translation, read-aloud, saved word review",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "productName": "Hanzi Buddy",
  "private": true,
  "build": {
    "appId": "com.hanzibuddy.app",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "!dist/test-lookup*", "!dist/**/*.map", "!node_modules/**/*"],
    "extraResources": [
      { "from": "bin", "to": "bin" },
      { "from": "data", "to": "data" }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": ["dmg"],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": { "LSUIElement": true }
    }
  }
}
